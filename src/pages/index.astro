---
import Main from '../layouts/Main.astro';
import { createDefaultSiteData } from '../data/defaults.ts';
import { getVisibleServices, getWhatsAppQuoteHref } from '../lib/storefront.ts';

// PVC-02: Derleme anında örnek içerik. Demo paneli ve canlı API henüz bağlanmadı.
const { business, categories } = createDefaultSiteData();
const visibleServices = getVisibleServices(categories);
const glassServices = visibleServices.filter((service) => service.group === 'cam-balkon');
const pvcServices = visibleServices.filter((service) => service.group === 'pvc');
const whatsappHref = getWhatsAppQuoteHref(business);
const mainActionHref = whatsappHref ?? '#iletisim';
const mainActionText = whatsappHref ? 'WhatsApp’tan teklif iste' : 'Teklif bilgisi al';
---
<Main title={business.name + ' | Cam Balkon & PVC'} description="Cam Balkon ve PVC işletmeleri için örnek web sitesi tasarımı. Gerçek firma bilgileri ve proje fotoğrafları henüz eklenmemiştir." palette={business.palette}>
  <div class="demo-ribbon" role="status">
    <div class="container demo-ribbon__inner">
      <span class="demo-ribbon__dot" aria-hidden="true"></span>
      <span><strong>Örnek site tasarımı</strong> — Fotoğraflar, firma bilgileri ve WhatsApp henüz tanımlanmadı.</span>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#ust" aria-label={business.name + ' ana sayfa'}>
        <span class="brand-symbol" aria-hidden="true">
          <svg viewBox="0 0 48 48" focusable="false"><rect x="7" y="6" width="34" height="36" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M24 8v32M9 25h30" fill="none" stroke="currentColor" stroke-width="2"/><path d="M14 13h4M30 33h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span class="brand-copy"><strong>{business.name}</strong><small>{business.tagline}</small></span>
      </a>

      <nav class="desktop-nav" aria-label="Ana menü">
        <a href="#ust">Ana Sayfa</a>
        <a href="#hizmetler">Hizmetlerimiz</a>
        <a href="#projeler">Projeler</a>
        <a href="#hakkimizda">Hakkımızda</a>
        <a href="#iletisim">İletişim</a>
      </nav>

      <div class="header-actions">
        <a class="header-quote" href={mainActionHref}>
          <span>{whatsappHref ? 'WhatsApp’tan Teklif' : 'Teklif Bilgisi'}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Menüyü aç veya kapat">
            <span class="mobile-menu__label">Menü</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </summary>
          <nav class="mobile-menu__list" aria-label="Mobil menü">
            <a href="#ust">Ana Sayfa</a>
            <a href="#hizmetler">Hizmetlerimiz</a>
            <a href="#projeler">Projeler</a>
            <a href="#hakkimizda">Hakkımızda</a>
            <a href="#iletisim">İletişim</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="ust">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span> YAŞAM ALANLARINA YENİ BİR BAKIŞ</div>
          <h1 id="hero-title">Manzaranız kalsın.<br /><em>Konforunuz artsın.</em></h1>
          <p class="hero-lead">Cam balkon ve PVC çözümleriyle yaşam alanlarınıza ferahlık katın. İhtiyacınızı paylaşın, projenize uygun teklif sürecini başlatalım.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={mainActionHref}>
              <span>{mainActionText}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
            <a class="button button-outline" href="#hizmetler">Hizmetleri keşfet</a>
          </div>
          <p class="hero-note">{whatsappHref ? 'Teklif talebi WhatsApp uygulamanızda açılır; mesajı siz gönderirsiniz.' : 'Demo notu: WhatsApp numarası henüz tanımlanmadı. Buton iletişim bilgisi alanına gider.'}</p>
          <div class="hero-qualities" aria-label="Site şablonu özellikleri">
            <div><span class="quality-icon" aria-hidden="true">01</span><span><strong>Ölçüye özel süreç</strong><small>İhtiyaca uygun talep</small></span></div>
            <div><span class="quality-icon" aria-hidden="true">02</span><span><strong>Şeffaf iletişim</strong><small>WhatsApp teklif akışı</small></span></div>
          </div>
        </div>

        <div class="hero-art">
          <div class="hero-art__inner">
            {business.heroImageUrl ? (
              <img class="hero-image" src={business.heroImageUrl} alt={business.name + ' cam balkon veya PVC uygulama fotoğrafı'} width="760" height="900" fetchpriority="high" />
            ) : (
              <div class="architectural-scene" role="img" aria-label="Gerçek proje fotoğrafının geleceği alanı gösteren temsili cam balkon çizimi">
                <div class="scene-sun" aria-hidden="true"></div>
                <div class="scene-buildings" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="scene-glass" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <div class="scene-floor" aria-hidden="true"></div>
                <div class="scene-photo-label"><span>ÖRNEK GÖRSEL ALANI</span><strong>Gerçek proje fotoğrafı eklenecek</strong></div>
              </div>
            )}
          </div>
          <div class="hero-floating-label"><span class="hero-floating-label__spark" aria-hidden="true">✦</span><span>Cam balkon & PVC<br /><strong>İşletmenizin dijital vitrini</strong></span></div>
          <span class="hero-outline" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <section id="hizmetler" class="services-section section-shell" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header">
          <div><p class="section-kicker">HİZMETLERİMİZ</p><h2 id="services-heading">Her mekâna uygun <em>çözümler.</em></h2></div>
          <p class="section-intro">İster balkonunuzu dört mevsim kullanın, ister pencerelerinizi yenileyin. Hizmetleri ve seçenekleri keşfedin.</p>
        </div>
        <div class="service-feature-grid">
          {glassServices.length > 0 && (
            <article class="service-feature" id="cam-balkon">
              <div class="service-illustration service-illustration--glass" aria-label="Cam balkon görseli için temsili yer tutucu">
                <div class="mini-window mini-window--glass" aria-hidden="true"><i></i><i></i><i></i></div>
                <span class="visual-disclaimer">Temsili görsel · Demo</span>
              </div>
              <div class="service-feature__content">
                <span class="service-number">01 / CAM BALKON</span>
                <h3>Manzaraya kesintisiz bir davet.</h3>
                <p>Balkonunuzu daha işlevsel bir yaşam alanına dönüştürmek için sistem seçeneklerini inceleyin.</p>
                <ul class="service-tags">
                  {glassServices.map((service) => <li>{service.name}</li>)}
                </ul>
                <a class="text-link" href="#iletisim">Cam Balkon için bilgi al <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          )}
          {pvcServices.length > 0 && (
            <article class="service-feature" id="pvc">
              <div class="service-illustration service-illustration--pvc" aria-label="PVC pencere görseli için temsili yer tutucu">
                <div class="mini-window mini-window--pvc" aria-hidden="true"><i></i><i></i></div>
                <span class="visual-disclaimer">Temsili görsel · Demo</span>
              </div>
              <div class="service-feature__content">
                <span class="service-number">02 / PVC SİSTEMLER</span>
                <h3>İçeride konfor, dışarıda dünya.</h3>
                <p>Pencere ve kapı sistemlerinde ölçüye göre değerlendirilen seçeneklerle yaşam alanınızı planlayın.</p>
                <ul class="service-tags">
                  {pvcServices.map((service) => <li>{service.name}</li>)}
                </ul>
                <a class="text-link" href="#iletisim">PVC için bilgi al <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          )}
        </div>
        <p class="section-demo-note">Bu şablonda yalnızca görünür olarak tanımlanmış hizmet kategorileri listelenir. Görseller ve açıklamalar örnek yer tutuculardır.</p>
      </div>
    </section>

    <section id="projeler" class="projects-section section-shell" aria-labelledby="projects-heading">
      <div class="container">
        <div class="section-header section-header--projects">
          <div><p class="section-kicker">TAMAMLANAN İŞLER</p><h2 id="projects-heading">İşiniz konuşsun.<br /><em>Fotoğraflar anlatsın.</em></h2></div>
          <p class="section-intro">Gerçek uygulama fotoğrafları yüklendiğinde bu alanda projeler sergilenecek. Şimdilik örnek vitrin düzenini görüyorsunuz.</p>
        </div>
        <div class="project-grid">
          {['Cam balkon uygulaması', 'PVC pencere uygulaması', 'Önce / sonra proje alanı'].map((label, index) => (
            <article class={'project-card project-card--' + (index + 1)}>
              <div class="project-card__visual">
                <span class="project-card__marker">0{index + 1}</span>
                <svg viewBox="0 0 96 80" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="11" y="11" width="74" height="58" rx="4"/><circle cx="33" cy="29" r="7"/><path d="m15 62 19-18 14 12 15-23 18 29"/></svg>
                <span class="project-card__demo">Gerçek fotoğraf eklenecek</span>
              </div>
              <div class="project-card__footer"><h3>{label}</h3><span>DEMO ALANI</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="hakkimizda" class="approach-section section-shell" aria-labelledby="approach-heading">
      <div class="container approach-grid">
        <div class="approach-heading">
          <p class="section-kicker">NASIL ÇALIŞIR?</p>
          <h2 id="approach-heading">İhtiyacınızı anlatın.<br /><em>Gerisini planlayalım.</em></h2>
          <p>Bu bölüm, müşterinin teklif alma sürecini anlaşılır biçimde anlatmak için tasarlanmış örnek içeriktir.</p>
        </div>
        <ol class="steps-list">
          <li><span>01</span><div><h3>Hizmeti seçin</h3><p>Cam balkon veya PVC ihtiyacınızı belirleyin.</p></div></li>
          <li><span>02</span><div><h3>Ölçü ve detayları paylaşın</h3><p>İlgili ürünün ölçülerini ve tercihlerinizi iletin.</p></div></li>
          <li><span>03</span><div><h3>Teklif sürecini başlatın</h3><p>WhatsApp üzerinden işletmeyle görüşerek ayrıntıları netleştirin.</p></div></li>
        </ol>
      </div>
    </section>

    <section id="iletisim" class="contact-section section-shell" aria-labelledby="contact-heading">
      <div class="container contact-card">
        <div>
          <p class="section-kicker section-kicker--light">İLETİŞİM & TEKLİF</p>
          <h2 id="contact-heading">Aklınızdaki projeyi <em>konuşalım.</em></h2>
          <p>İhtiyacınız olan cam balkon veya PVC çözümü için iletişim sürecini burada başlatabilirsiniz.</p>
          {!whatsappHref && <p class="contact-demo-warning" role="status">Demo modu: İşletmenin WhatsApp numarası henüz eklenmedi. Bu tasarımdan gerçek mesaj gönderilemez.</p>}
        </div>
        <div class="contact-action">
          {whatsappHref ? (
            <a class="button button-light" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp'tan teklif iste <span aria-hidden="true">↗</span></a>
          ) : (
            <span class="button button-light button-inactive" aria-disabled="true">WhatsApp numarası bekleniyor</span>
          )}
          <small>{whatsappHref ? 'WhatsApp açılır; mesajı siz onaylayıp gönderirsiniz.' : 'İletişim bağlantısı işletme bilgileri tamamlanınca etkinleşir.'}</small>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div><strong>{business.name}</strong><p>Cam Balkon & PVC web sitesi şablonu · Örnek tasarım.</p></div>
      <nav aria-label="Alt menü"><a href="#hizmetler">Hizmetler</a><a href="#projeler">Projeler</a><a href="#iletisim">İletişim</a></nav>
    </div>
  </footer>

  <div class="mobile-cta" aria-label="Mobil teklif bağlantısı">
    <a href={mainActionHref} class="mobile-cta__button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5A8.5 8.5 0 0 1 7.2 18.8L3 20l1.2-4.2A8.5 8.5 0 1 1 20 11.5Z"/><path d="M8 9c1 2 3 4 5 5" /></svg>
      {whatsappHref ? 'WhatsApp’tan Teklif İste' : 'Teklif ve İletişim Bilgisi'}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</Main>
